# PostgreSQL connection string (required)
DATABASE_URL=postgres://buildforge:buildforge@localhost:5432/buildforge
# TLS mode: disable (local) | verify (production with valid certs) | default (managed PG)
PGSSL=disable

# JWT signing secret — REQUIRED; the server refuses to boot in production without it
JWT_SECRET=

# Comma-separated CORS allow-list for the web app origins
ALLOWED_ORIGINS=http://localhost:5173

PORT=4000

# Outbound email (notifications + automation send_email action).
# Leave SMTP_HOST empty to disable email; in-app notifications still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@yourdomain.com

# Optional integrations
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Permissions default when a user has no explicit tool permission row.
# 'none' = deny-by-default (recommended); unset preserves legacy 'standard'.
DEFAULT_TOOL_PERMISSION=none
