# Base URL of the BuildForge backend API (no trailing slash).
# Local dev example: http://localhost:4000/api
# Production example: https://scheduler-production-6ac2.up.railway.app/api
VITE_API_BASE=http://localhost:4000/api

# Base URL of your EXISTING (classic) BuildForge app. Used by the new shell to
# link to modules that haven't been ported into the new design yet, so no
# feature is lost during the rollout. Example: https://your-app.vercel.app
VITE_LEGACY_BASE=
